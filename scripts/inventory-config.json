  "bases": [
    {
      "type": "argument",
      "function": "MgrasInitBoardGfx|MgrasProbe|MgrasReset|MgrasBlankScreen|MgrasDownloadUcode|MgrasInitCCR|CCInit|PhaseOne|PhaseTwo|MgrasStartDMA|MgrasWaitDMA|MgrasEnableRetraceInterrupts|MgrasEnableVideoTiming|MgrasLoadVC3SRAM|MgrasInitCursor|MgrasClearCursor",
      "reg": 4,
      "window": "mmio",
      "label": "register base argument",
      "binaries": [
        "usr/cpu/sysgen/IP28boot/*"
      ],
      "why": "mgras_kern.h declares each of these with mgras_hw *base as its first argument, the mapped register aperture"
    },
    {
      "type": "field",
      "disp": 38544,
      "loads": [
        "ld"
      ],
      "window": "mmio",
      "label": "context +0x9690",
      "binaries": [
        "*libGLcore.so"
      ],
      "why": "glcore_mgras.h puts the mgras_hw pointer at context offset 0x9690, and libGLcore stores register writes through it"
    }
  ],
