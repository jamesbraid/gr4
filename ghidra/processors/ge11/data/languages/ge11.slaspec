LASTN: "nop" is fimm=0x0 & fw71=0x0 & f222=0x0 & f221=0x0 & f220=0x0 & f219=0x0 & f217=0x0 & f215=0x0 & f213=0x0 & f211=0x0 & fcc=0x11 & f198=0x14 & fA=0x0 & fB=0x0 & fC=0x0 & f176=0x3 & fD=0x0 & fE=0x0 & f162=0x0 & fF=0x1f & fG=0x1f & f148l=0x0 & f148h=0x0 & fP=0x1f & fQ=0x1f & f128=0x2d & fMu=0x7f & fMk=0xd & f110=0x6bd & f99l=0x0 & f99h=0x0 & f95=0x0 & fsgrp=0x4 & fsmid=0x7f & fsop=0x6 & fsrel=0x0 & fsind=0x0 & f71=0x0 & f62l=0xfc000170 & f62h=0x1f & f25=0x3e29c00 { }
