# ---- Semantics
macro flagshift() {
  FLD12 = FLD11;
  FLD11 = FLD10;
  FLD10 = FLD9;
  FLD9 = FLD8;
  FLD8 = FLD7;
  FLD7 = FLD6;
  FLD6 = FLD5;
  FLD5 = FLD4;
  FLD4 = FLD3;
  FLD3 = FLD2;
  FLD2 = FLD1;
  FLD1 = FL;
  U1H7 = U1H6;
  U1H6 = U1H5;
  U1H5 = U1H4;
  U1H4 = U1H3;
  U1H3 = U1H2;
  U1H2 = U1H1;
  U1H1 = U1H0;
  U2H7 = U2H6;
  U2H6 = U2H5;
  U2H5 = U2H4;
  U2H4 = U2H3;
  U2H3 = U2H2;
  U2H2 = U2H1;
  U2H1 = U2H0;
  AZD2 = AZD1; AGTD2 = AGTD1; AZD1 = AZ; AGTD1 = AGT;
  SEED = SEED1; SEED1 = SEED0;
}
# One nibble of the condition word from a result (ge_ops.md, "Branch
# conditions"): bit 3 <= 0, bit 2 zero, bit 1 negative, ESTABLISHED for the
# test cases; bit 0 "passed its second operand" INFERRED from the GE11 labels
# and approximated here as result == second operand.
macro inib(n, r, b) { n = ((r s<= 0) << 3) | ((r == 0) << 2) | ((r s< 0) << 1) | (r == b); }
macro fnib(n, r, b) { local z:4 = int2float(0:4); n = ((r f<= z) << 3) | ((r f== z) << 2) | ((r f< z) << 1) | (r == b); }

# Memory reads. Through A and D (INFERRED reading of A/D, ge_isa.md
# "Fields"): A = 0x1f is word D of the command, read where it arrived
# (INFERRED); its WRAM base is UNKNOWN, so D is used alone. r99 bit 3
# brings that word to the operand ports as "the word the instruction
# reads" (LDV); r99 bit 2 makes it a read with no destination, whose word
# a later port takes as "the loaded word" (LDL) (ge_isa.md "Operand ports",
# 0x7281 and the diagnostic 0x0988).
ADR: is fA=0x1f & fD { export *[wram]:4 fD; }
ADR: is fAr & fD { local a:4 = fAr + fD; export *[dmem]:4 a; }
LDR: is f99h=0 & f99b2=0 { }
LDR: is f99h=1 & f99b2=0 & ADR { LDV = ADR; }
LDR: is f99h=0 & f99b2=1 & ADR { LDL = ADR; }
LDR: is f99h=1 & f99b2=1 & ADR { LDV = ADR; LDL = LDV; }
# Reads through C also load LDL. r95 = 0x13 reads CRAM: at the immediate
# in form 5 and, in form 14, with C = 0x1e (ESTABLISHED, ge_ops.md
# "Control-memory addresses in immediates"); at address register C plus
# 0x1f - F otherwise (INFERRED from mMatrixCopyCC, ge_compute.md).
# r95 = 0x17 reads ERAM: at the immediate with C = 0x1e (INFERRED,
# mmo_CopyFifoLine); through C with the same 0x1f - F offset (INFERRED here:
# mmo_Clamp reads its parameter block with F = 0x1a down to 0xf through one
# C). r95 = 0x14 with C = 0x1e is a read with no destination (0xa7e8, the
# raster position); its memory is UNKNOWN, so a pcodeop. A read in the
# word that consumes it is seen by that word (uMatrixMultCCC 0xe72-0xe75).
CR13R: is fC=0x1e & fimm { LDL = *[cram]:4 fimm:2; }
CR13R: is fCr & fF { local a:4 = fCr + (0x1f - fF); LDL = *[cram]:4 a:2; }
CR13: is fform=5 & fimm { LDL = *[cram]:4 fimm:2; }
CR13: is CR13R { build CR13R; }
CR17: is fC=0x1e & fimm { LDL = *[eram]:4 fimm:4; }
CR17: is fCr & fF { local a:4 = fCr + (0x1f - fF); LDL = *[eram]:4 a; }
CRD: is f95=0x13 & CR13 { build CR13; }
CRD: is f95=0x17 & CR17 { build CR17; }
CRD: is f95=0x14 & fC=0x1e & fimm { LDL = read_r95_14(fimm:4); }
CRD: is f95 { }
# Forwarded results (ESTABLISHED): r128 code k = 0-3 is the unit-1 result
# 4 + k words back, 4-7 the unit-2 result 4 + (k - 4) words back.
FW1: is f128p1=0 { P1V = U1H4; }
FW1: is f128p1=1 { P1V = U1H5; }
FW1: is f128p1=2 { P1V = U1H6; }
FW1: is f128p1=3 { P1V = U1H7; }
FW1: is f128p1=4 { P1V = U2H4; }
FW1: is f128p1=5 { P1V = U2H5; }
FW1: is f128p1=6 { P1V = U2H6; }
FW1: is f128p1=7 { P1V = U2H7; }
FW2: is f128p2=0 { P2V = U1H4; }
FW2: is f128p2=1 { P2V = U1H5; }
FW2: is f128p2=2 { P2V = U1H6; }
FW2: is f128p2=3 { P2V = U1H7; }
FW2: is f128p2=4 { P2V = U2H4; }
FW2: is f128p2=5 { P2V = U2H5; }
FW2: is f128p2=6 { P2V = U2H6; }
FW2: is f128p2=7 { P2V = U2H7; }
# Unit-1 ports (ESTABLISHED selectors 0 and 1, INFERRED 2 and 3): r110
# bits 9-8 pick port 1, 7-6 port 2; 0 a register named in r148, 1 a
# forwarded result named in r128, 2 the word the instruction reads (LDV),
# 3 the loaded word (LDL). A subtract returns port 1 minus port 2.
PT1: is f110s1=0 & f148hr { P1V = f148hr; }
PT1: is f110s1=1 & FW1 { build FW1; }
PT1: is f110s1=2 { P1V = LDV; }
PT1: is f110s1=3 { P1V = LDL; }
PT2: is f110s2=0 & f148lr { P2V = f148lr; }
PT2: is f110s2=1 & FW2 { build FW2; }
PT2: is f110s2=2 { P2V = LDV; }
PT2: is f110s2=3 { P2V = LDL; }
# Unit-2 ports (ESTABLISHED selectors 0-2, INFERRED 3; ge_isa.md "Unit-2
# and seed-unit operands"): r110 bits 5-4 pick port 1 (OPAV), 3-2 port 2
# (OPBV); 0 the seed result two words back, 1 a register named in r148
# (bits 9-5, 4-0), 2 a forwarded result named in r128 (bits 5-3, 2-0) by
# the unit-1 rule, 3 a memory word: port 1 the word read through A and D
# (LDV, which keeps the last word read when a word reads nothing), port 2
# the loaded word (LDL) (INFERRED, the matrix multiply-adds).
FU1: is f128p1=0 { OPAV = U1H4; }
FU1: is f128p1=1 { OPAV = U1H5; }
FU1: is f128p1=2 { OPAV = U1H6; }
FU1: is f128p1=3 { OPAV = U1H7; }
FU1: is f128p1=4 { OPAV = U2H4; }
FU1: is f128p1=5 { OPAV = U2H5; }
FU1: is f128p1=6 { OPAV = U2H6; }
FU1: is f128p1=7 { OPAV = U2H7; }
FU2: is f128p2=0 { OPBV = U1H4; }
FU2: is f128p2=1 { OPBV = U1H5; }
FU2: is f128p2=2 { OPBV = U1H6; }
FU2: is f128p2=3 { OPBV = U1H7; }
FU2: is f128p2=4 { OPBV = U2H4; }
FU2: is f128p2=5 { OPBV = U2H5; }
FU2: is f128p2=6 { OPBV = U2H6; }
FU2: is f128p2=7 { OPBV = U2H7; }
OP2A: is f110u1=0 { OPAV = SEED; }
OP2A: is f110u1=1 & f148hr { OPAV = f148hr; }
OP2A: is f110u1=2 & FU1 { build FU1; }
OP2A: is f110u1=3 { OPAV = LDV; }
OP2B: is f110u2=0 { OPBV = SEED; }
OP2B: is f110u2=1 & f148lr { OPBV = f148lr; }
OP2B: is f110u2=2 & FU2 { build FU2; }
OP2B: is f110u2=3 { OPBV = LDL; }
# Seed operand (ESTABLISHED): r110 bit 1 set takes the register in r148
# bits 9-5, clear the forwarded result in r128 bits 5-3.
FSD: is f128p1=0 { SDOP = U1H4; }
FSD: is f128p1=1 { SDOP = U1H5; }
FSD: is f128p1=2 { SDOP = U1H6; }
FSD: is f128p1=3 { SDOP = U1H7; }
FSD: is f128p1=4 { SDOP = U2H4; }
FSD: is f128p1=5 { SDOP = U2H5; }
FSD: is f128p1=6 { SDOP = U2H6; }
FSD: is f128p1=7 { SDOP = U2H7; }
SDO: is f110sd=1 & f148hr { SDOP = f148hr; }
SDO: is f110sd=0 & FSD { build FSD; }
OPS: is LDR & CRD & PT1 & PT2 & OP2A & OP2B & SDO { build LDR; build CRD; build PT1; build PT2; build OP2A; build OP2B; build SDO; }

U1S: is fMu=0x7f { }
# 0x20 dadd: double add, ESTABLISHED (ge_inst.s 3829); the two-word pairing is not mapped, so a pcodeop
U1S: is fMu=0x20 { U1V = dadd(P1V, P2V); STV = U1V; U1H0 = U1V; }
# 0x22 dsub: double subtract, ESTABLISHED (ge_inst.s 3858); two-word pairing not mapped, pcodeop
U1S: is fMu=0x22 { U1V = dsub(P1V, P2V); STV = U1V; U1H0 = U1V; }
# 0x40 iadd: integer add, ESTABLISHED; saturates at the signed limit, GE11-only, ESTABLISHED (6.5.7 iadd test)
U1S: is fMu=0x40 { U1V = iadd_sat(P1V, P2V); STV = U1V; U1H0 = U1V; }
# 0x42 isub: integer subtract A - B, ESTABLISHED not wrapping; saturating INFERRED
U1S: is fMu=0x42 { U1V = isub_sat(P1V, P2V); STV = U1V; U1H0 = U1V; }
# 0x4a mov: move of the first operand, ESTABLISHED
U1S: is fMu=0x4a { U1V = P1V; STV = U1V; U1H0 = U1V; }
# 0x4b movb: move of the second operand, ESTABLISHED
U1S: is fMu=0x4b { U1V = P2V; STV = U1V; U1H0 = U1V; }
# 0x50 and: AND, INFERRED by intent (test ties AND/NOR)
U1S: is fMu=0x50 { U1V = P1V & P2V; STV = U1V; U1H0 = U1V; }
# 0x54 or: OR, INFERRED by function (test ties OR/XOR/NAND)
U1S: is fMu=0x54 { U1V = P1V | P2V; STV = U1V; U1H0 = U1V; }
# 0x56 xor: XOR, INFERRED by function
U1S: is fMu=0x56 { U1V = P1V ^ P2V; STV = U1V; U1H0 = U1V; }
# 0x58 not: bitwise NOT of the first operand, ESTABLISHED
U1S: is fMu=0x58 { U1V = ~P1V; STV = U1V; U1H0 = U1V; }
# 0x5b sra: arithmetic shift right by the second operand, INFERRED
U1S: is fMu=0x5b { U1V = P1V s>> P2V; STV = U1V; U1H0 = U1V; }
# 0x5d srl: logical shift right by the second operand, INFERRED
U1S: is fMu=0x5d { U1V = P1V >> P2V; STV = U1V; U1H0 = U1V; }
# 0x5f sll: shift left by the second operand, INFERRED
U1S: is fMu=0x5f { U1V = P1V << P2V; STV = U1V; U1H0 = U1V; }
# 0x60 fadd: single add, ESTABLISHED
U1S: is fMu=0x60 { U1V = P1V f+ P2V; STV = U1V; U1H0 = U1V; }
# 0x62 fsub: single subtract first - second, ESTABLISHED for two registers (ge_inst.s 3774)
U1S: is fMu=0x62 { U1V = P1V f- P2V; STV = U1V; U1H0 = U1V; }
# 0x66 fmin: minimum, INFERRED (mmo_Minmax)
U1S: is fMu=0x66 { U1V = fmin(P1V, P2V); STV = U1V; U1H0 = U1V; }
# 0x68 fmax: maximum, INFERRED (mmo_Minmax)
U1S: is fMu=0x68 { U1V = fmax(P1V, P2V); STV = U1V; U1H0 = U1V; }
# 0x71 ftoi: float to integer, INFERRED (mmo_FloatToInt); rounding UNKNOWN, so a pcodeop
U1S: is fMu=0x71 { U1V = ftoi(P1V); STV = U1V; U1H0 = U1V; }
# 0x73 itof: integer to single, ESTABLISHED
U1S: is fMu=0x73 { U1V = int2float(P1V); STV = U1V; U1H0 = U1V; }
# 0x7c clamp: clamp to [0, 1]: below at 0 ESTABLISHED, above at 1.0 INFERRED; NaN UNKNOWN, so a pcodeop
U1S: is fMu=0x7c { U1V = clamp01(P1V); STV = U1V; U1H0 = U1V; }
# Unit-1 codes no document identifies: named, not given a meaning.
U1S: is fMu { U1V = u1_op(fMu:1, P1V, P2V); STV = U1V; U1H0 = U1V; }
U2S: is fMk=0xd { }
# k=0x0 (code 0x07) dmul: double multiply 0x07, ESTABLISHED; two-word pairing not mapped, pcodeop
U2S: is fMk=0x0 { U2V = dmul(OPAV, OPBV); STV = U2V; U2H0 = U2V; }
# k=0x1 (code 0x0f) imul: integer multiply 0x0f, low 32 bits, INFERRED (GE11 imul)
U2S: is fMk=0x1 { U2V = OPAV * OPBV; STV = U2V; U2H0 = U2V; }
# k=0x4 (code 0x27) fmov: unit-2 move of the first operand 0x27, ESTABLISHED
U2S: is fMk=0x4 { U2V = OPAV; STV = U2V; U2H0 = U2V; }
# k=0x6 (code 0x37) dmov: double move of the first pair 0x37, ESTABLISHED (one word of it)
U2S: is fMk=0x6 { U2V = OPAV; STV = U2V; U2H0 = U2V; }
# k=0x8 (code 0x47) fmul: single multiply 0x47, ESTABLISHED bit for bit
U2S: is fMk=0x8 { U2V = OPAV f* OPBV; STV = U2V; U2H0 = U2V; }
# k=0x9 (code 0x4f) rcpstep: 2 - a*b 0x4f, Newton-Raphson reciprocal step, ESTABLISHED bit for bit
U2S: is fMk=0x9 { U2V = int2float(2:4) f- (OPAV f* OPBV); STV = U2V; U2H0 = U2V; }
# k=0xa (code 0x57) rsqstep: (3 - a*b)/2 0x57, Newton-Raphson reciprocal-square-root step, ESTABLISHED bit for bit
U2S: is fMk=0xa { U2V = (int2float(3:4) f- (OPAV f* OPBV)) f/ int2float(2:4); STV = U2V; U2H0 = U2V; }
# k = 5 (0x2f: move of B or minimum), 7 (0x3f) and the rest: UNKNOWN.
U2S: is fMk { U2V = u2_op(fMk:1, OPAV, OPBV); STV = U2V; U2H0 = U2V; }

# Seed unit (ESTABLISHED, ge_isa.md "Unit-2 and seed-unit operands"): it
# runs in every word on SDOP; r110 bit 10 set gives the reciprocal seed,
# clear the reciprocal-square-root seed, and unit 2 reads it two words
# later. APPROXIMATION: the seeds are within 0.4%% with 7 fraction bits
# (ESTABLISHED) but the table is UNKNOWN, so the exact 1/x and 1/sqrt(x)
# stand in; a seed nothing reads is dead code the decompiler drops.
SDS: is f110b10=1 { SEED0 = int2float(1:4) f/ SDOP; }
SDS: is f110b10=0 { SEED0 = int2float(1:4) f/ sqrt(SDOP); }

# Destinations: unit 1 writes Q, unit 2 writes P; 0x1f is the idle value
# (ESTABLISHED as the no-op value; "no register write" INFERRED: stores of a
# unit result carry it).
WQ: is fQ=0x1f { }
WQ: is fQr { fQr = U1V; }
WP: is fP=0x1f { }
WP: is fPr { fPr = U2V; }

# Address unit. Source C: the immediate when C = 0x1e (INFERRED), else an
# address register. F = 0x3f adds A and C (ESTABLISHED for the GE11 aalu3
# test, KONA areg.s agrees); F = 0x1f (idle value) and F = 0 pass C through
# (INFERRED: pointer copies in uxform.s, loop-count loads, areg.s loads);
# F = 0x20 and 0x25 step C down by one (INFERRED: GE11 eram_Databus, the
# counted loops). Other F values are UNKNOWN.
CSR: is fC=0x1e & fimm { CSRC = fimm; }
CSR: is fCr { CSRC = fCr; }
AOP: is fF=0x3f & fAr { AUV = fAr + CSRC; }
AOP: is fF=0x1f { AUV = CSRC; }
AOP: is fF=0x0 { AUV = CSRC; }
AOP: is fF=0x20 { AUV = CSRC - 1; }
AOP: is fF=0x25 { AUV = CSRC - 1; }
AOP: is fF & fAr { AUV = aalu(fF:1, fAr, CSRC); }
AUS: is f219=0 & f222=0 { }
# GE11: the address unit adds modulo 2^18 (ESTABLISHED, 6.5.7 aalu3 test);
# the result is kept sign-extended from bit 17, so the special-register
# and output windows keep their 32-bit spellings 0xfffe0000 and 0xffff0000.
AUS: is CSR & AOP { build CSR; build AOP; AUV = (AUV << 14) s>> 14; }
# r219 != 0 writes G (ESTABLISHED by areg.s for loads, INFERRED otherwise).
WG: is f219=0 { }
WG: is fGr { fGr = AUV; }
# r222: the address-unit result sets the address conditions (ESTABLISHED).
FLA: is f222=0 { }
FLA: is f222=1 { AZ = (AUV == 0); AGT = (AUV s> 0); }

# Stores. r213 = 3: the unit result to B + E (ESTABLISHED for the
# diagnostic output words), or to CRAM at the immediate when B = 0x1e and
# r95 = 0x13 (ESTABLISHED). r213 = 2 is the predicated form (INFERRED); the
# predicate is UNKNOWN. r215 = 3: the immediate to B + E (form 15 constant
# loads, INFERRED from ge_inst.s). r211 = 3 with r95 = 4: the unit result to
# CRAM through C (INFERRED, load-matrix handlers and mMatrixCopyCC).
SADDR: a is fB=0x1e & f95=0x13 & fimm [ a = fimm & 0xffff; ] { export *[cram]:4 a; }
SADDR: is fBr & fE { local a:4 = fBr + fE; export *[dmem]:4 a; }
ST3: is f213=0 { }
ST3: is f213=1 { }
ST3: is f213=3 & SADDR { SADDR = STV; }
ST3: is f213=2 & SADDR { local p:1 = store_predicate(); if (p == 0) goto <skip>; SADDR = STV; <skip> }
ST5: is f215=0 { }
ST5: is f215=1 { }
ST5: is f215=3 & fBr & fE & fimm { local a:4 = fBr + fE; *[dmem]:4 a = fimm:4; }
ST5: is f215=2 & fBr & fE & fimm { local a:4 = fBr + fE; local p:1 = store_predicate(); if (p == 0) goto <skip>; *[dmem]:4 a = fimm:4; <skip> }
ST1R: is fC=0x1e & fimm { *[cram]:4 fimm:2 = STV; }
ST1R: is fCr & fF { local a:4 = fCr + (0x1f - fF); *[cram]:4 a:2 = STV; }
ST1A: is fform=5 & fimm { *[cram]:4 fimm:2 = STV; }
ST1A: is ST1R { build ST1R; }
ST1: is f211=3 & f95=4 & ST1A { build ST1A; }
ST1: is epsilon { }

# Flags: r220 sets the low nibble from unit 1, r221 the high nibble from
# unit 2 (INFERRED split by unit, ge_ops.md).
FK1: is fMu=0x7f { }
FK1: is fMu=0x40 { local n:1; inib(n, U1V, P2V); FL = (FL & 0xf0) | n; }
FK1: is fMu=0x42 { local n:1; inib(n, U1V, P2V); FL = (FL & 0xf0) | n; }
FK1: is fMu=0x4a { local n:1; inib(n, U1V, P2V); FL = (FL & 0xf0) | n; }
FK1: is fMu=0x4b { local n:1; inib(n, U1V, P2V); FL = (FL & 0xf0) | n; }
FK1: is fMu=0x50 { local n:1; inib(n, U1V, P2V); FL = (FL & 0xf0) | n; }
FK1: is fMu=0x54 { local n:1; inib(n, U1V, P2V); FL = (FL & 0xf0) | n; }
FK1: is fMu=0x56 { local n:1; inib(n, U1V, P2V); FL = (FL & 0xf0) | n; }
FK1: is fMu=0x58 { local n:1; inib(n, U1V, P2V); FL = (FL & 0xf0) | n; }
FK1: is fMu=0x5b { local n:1; inib(n, U1V, P2V); FL = (FL & 0xf0) | n; }
FK1: is fMu=0x5d { local n:1; inib(n, U1V, P2V); FL = (FL & 0xf0) | n; }
FK1: is fMu=0x5f { local n:1; inib(n, U1V, P2V); FL = (FL & 0xf0) | n; }
FK1: is fMu=0x60 { local n:1; fnib(n, U1V, P2V); FL = (FL & 0xf0) | n; }
FK1: is fMu=0x62 { local n:1; fnib(n, U1V, P2V); FL = (FL & 0xf0) | n; }
FK1: is fMu=0x66 { local n:1; fnib(n, U1V, P2V); FL = (FL & 0xf0) | n; }
FK1: is fMu=0x68 { local n:1; fnib(n, U1V, P2V); FL = (FL & 0xf0) | n; }
FK1: is fMu=0x71 { local n:1; inib(n, U1V, P2V); FL = (FL & 0xf0) | n; }
FK1: is fMu=0x73 { local n:1; fnib(n, U1V, P2V); FL = (FL & 0xf0) | n; }
FK1: is fMu=0x7c { local n:1; fnib(n, U1V, P2V); FL = (FL & 0xf0) | n; }
FK1: is fMu { local n:1 = passb(fMu:1, U1V, P2V); FL = (FL & 0xf0) | n; }
FK2: is fMk=0xd { }
FK2: is fMk=0x1 { local n:1; inib(n, U2V, OPBV); FL = (FL & 0x0f) | (n << 4); }
FK2: is fMk=0x4 { local n:1; fnib(n, U2V, OPBV); FL = (FL & 0x0f) | (n << 4); }
FK2: is fMk=0x6 { local n:1; fnib(n, U2V, OPBV); FL = (FL & 0x0f) | (n << 4); }
FK2: is fMk=0x8 { local n:1; fnib(n, U2V, OPBV); FL = (FL & 0x0f) | (n << 4); }
FK2: is fMk=0x9 { local n:1; fnib(n, U2V, OPBV); FL = (FL & 0x0f) | (n << 4); }
FK2: is fMk=0xa { local n:1; fnib(n, U2V, OPBV); FL = (FL & 0x0f) | (n << 4); }
FK2: is fMk { local n:1 = passb(fMk:1, U2V, OPBV); FL = (FL & 0x0f) | (n << 4); }
FL1: is f220=0 { }
FL1: is f220=1 & FK1 { build FK1; }
FL2: is f221=0 { }
FL2: is f221=1 & FK2 { build FK2; }

# A word's own work: operands are read before anything is written, so the
# units, the address unit and the stores all see the values from before it.
BODY: is OPS & U1S & U2S & SDS & AUS & WQ & WP & WG & FLA & ST3 & ST5 & ST1 & FL1 & FL2 {
  flagshift();
  build OPS; build U1S; build U2S; build SDS; build AUS;
  build ST3; build ST5; build ST1;
  build WQ; build WP; build WG;
  build FLA; build FL1; build FL2;
}

# Conditions (ge_ops.md). cc 0-15 test the condition word as it was twelve
# words earlier (ESTABLISHED for KONA, "The twelve-word flag delay"): cc
# 0-7 the low nibble, 8-15 the high; address conditions are two words
# late (ESTABLISHED);
# cc bits 2-1 pick <= 0, zero, negative, second-operand-passed and bit 0
# inverts (ESTABLISHED for the test cases). cc 0x10/0x11 address result
# zero/not zero, 0x14/0x15 > 0 / <= 0 (ESTABLISHED by the GE11 labels).
# cc 0x10 in group 31 is an abort request from outside (INFERRED). Others
# (0x72 and 0x76 dirty flags, 0x60-0x7f dispatch tests) are UNKNOWN.
COND: is fcc=0x0 { local c:1 = ((FLD12 >> 3) & 1) != 0; export c; }
COND: is fcc=0x1 { local c:1 = ((FLD12 >> 3) & 1) == 0; export c; }
COND: is fcc=0x2 { local c:1 = ((FLD12 >> 2) & 1) != 0; export c; }
COND: is fcc=0x3 { local c:1 = ((FLD12 >> 2) & 1) == 0; export c; }
COND: is fcc=0x4 { local c:1 = ((FLD12 >> 1) & 1) != 0; export c; }
COND: is fcc=0x5 { local c:1 = ((FLD12 >> 1) & 1) == 0; export c; }
COND: is fcc=0x6 { local c:1 = ((FLD12 >> 0) & 1) != 0; export c; }
COND: is fcc=0x7 { local c:1 = ((FLD12 >> 0) & 1) == 0; export c; }
COND: is fcc=0x8 { local c:1 = ((FLD12 >> 7) & 1) != 0; export c; }
COND: is fcc=0x9 { local c:1 = ((FLD12 >> 7) & 1) == 0; export c; }
COND: is fcc=0xa { local c:1 = ((FLD12 >> 6) & 1) != 0; export c; }
COND: is fcc=0xb { local c:1 = ((FLD12 >> 6) & 1) == 0; export c; }
COND: is fcc=0xc { local c:1 = ((FLD12 >> 5) & 1) != 0; export c; }
COND: is fcc=0xd { local c:1 = ((FLD12 >> 5) & 1) == 0; export c; }
COND: is fcc=0xe { local c:1 = ((FLD12 >> 4) & 1) != 0; export c; }
COND: is fcc=0xf { local c:1 = ((FLD12 >> 4) & 1) == 0; export c; }
COND: is fcc=0x10 & fsgrp=31 { local c:1 = abort_requested(); export c; }
COND: is fcc=0x10 & fsgrp { local c:1 = AZD2; export c; }
COND: is fcc=0x11 { local c:1 = !AZD2; export c; }
COND: is fcc=0x14 { local c:1 = AGTD2; export c; }
COND: is fcc=0x15 { local c:1 = !AGTD2; export c; }
COND: is fcc { local c:1 = cond_test(fcc:2); export c; }

# ---- Instructions
# Words without a transfer (sequencer code 6, ESTABLISHED as the common case).
:^MN FIELDS is fvalid=1 & fsop=6 & MN & FIELDS & BODY & wlo { build BODY; }
# Delay slots: a transfer takes effect after four words (INFERRED from the
# GE11 microcode latency four and the call sites resuming at call + 5); a
# return after eight (ESTABLISHED for the GE11, MemRegInit writes them out).
# Ghidra cannot nest delay slots, and dispatch chains put transfers in each
# other's window, so the loader sets fdly to the words before the next
# transfer (at most 4 or 8) and those are the delay slots modelled. A
# transfer inside another's window is thus modelled as taking effect
# after the earlier one: an approximation of how the two overlap, which
# no document describes.
# Group 0 code 4: call (ESTABLISHED). Code 5 in group 0: conditional call
# (INFERRED: the transform modules' cc 0x72/0x76 calls). Code 4 without
# R88: jump; code 5: conditional jump (INFERRED); code 3: the loop form,
# conditional (INFERRED, mainloop/epilogue targets). R88 in group 31: end
# of command, on to the next handler the dispatch hardware supplies
# (INFERRED). R88 in other groups: return (ESTABLISHED for the GE11,
# INFERRED for KONA groups 4 and 5).
:call FIELDS is fvalid=1 & fsop=4 & fsind=0 & fsgrp=0 & fdly=0 & FIELDS & BODY & XT & wlo { build BODY;  LR = inst_start + 1; call XT; }
:call FIELDS is fvalid=1 & fsop=4 & fsind=0 & fsgrp=0 & fdly=1 & FIELDS & BODY & XT & wlo { build BODY;  delayslot(8); LR = inst_start + 2; call XT; }
:call FIELDS is fvalid=1 & fsop=4 & fsind=0 & fsgrp=0 & fdly=2 & FIELDS & BODY & XT & wlo { build BODY;  delayslot(16); LR = inst_start + 3; call XT; }
:call FIELDS is fvalid=1 & fsop=4 & fsind=0 & fsgrp=0 & fdly=3 & FIELDS & BODY & XT & wlo { build BODY;  delayslot(24); LR = inst_start + 4; call XT; }
:call FIELDS is fvalid=1 & fsop=4 & fsind=0 & fsgrp=0 & fdly=4 & FIELDS & BODY & XT & wlo { build BODY;  delayslot(32); LR = inst_start + 5; call XT; }
:callc FIELDS is fvalid=1 & fsop=5 & fsind=0 & fsgrp=0 & fdly=0 & FIELDS & BODY & XT & COND & wlo { build BODY; build COND; local c:1 = COND; if (!c) goto <skip>; LR = inst_start + 1; call XT; <skip> }
:callc FIELDS is fvalid=1 & fsop=5 & fsind=0 & fsgrp=0 & fdly=1 & FIELDS & BODY & XT & COND & wlo { build BODY; build COND; local c:1 = COND; delayslot(8); if (!c) goto <skip>; LR = inst_start + 2; call XT; <skip> }
:callc FIELDS is fvalid=1 & fsop=5 & fsind=0 & fsgrp=0 & fdly=2 & FIELDS & BODY & XT & COND & wlo { build BODY; build COND; local c:1 = COND; delayslot(16); if (!c) goto <skip>; LR = inst_start + 3; call XT; <skip> }
:callc FIELDS is fvalid=1 & fsop=5 & fsind=0 & fsgrp=0 & fdly=3 & FIELDS & BODY & XT & COND & wlo { build BODY; build COND; local c:1 = COND; delayslot(24); if (!c) goto <skip>; LR = inst_start + 4; call XT; <skip> }
:callc FIELDS is fvalid=1 & fsop=5 & fsind=0 & fsgrp=0 & fdly=4 & FIELDS & BODY & XT & COND & wlo { build BODY; build COND; local c:1 = COND; delayslot(32); if (!c) goto <skip>; LR = inst_start + 5; call XT; <skip> }
:jmp FIELDS is fvalid=1 & fsop=4 & fsind=0 & fdly=0 & FIELDS & BODY & XT & wlo { build BODY;  goto XT; }
:jmp FIELDS is fvalid=1 & fsop=4 & fsind=0 & fdly=1 & FIELDS & BODY & XT & wlo { build BODY;  delayslot(8); goto XT; }
:jmp FIELDS is fvalid=1 & fsop=4 & fsind=0 & fdly=2 & FIELDS & BODY & XT & wlo { build BODY;  delayslot(16); goto XT; }
:jmp FIELDS is fvalid=1 & fsop=4 & fsind=0 & fdly=3 & FIELDS & BODY & XT & wlo { build BODY;  delayslot(24); goto XT; }
:jmp FIELDS is fvalid=1 & fsop=4 & fsind=0 & fdly=4 & FIELDS & BODY & XT & wlo { build BODY;  delayslot(32); goto XT; }
:bc FIELDS is fvalid=1 & fsop=5 & fsind=0 & fdly=0 & FIELDS & BODY & XT & COND & wlo { build BODY; build COND; local c:1 = COND; if (c) goto XT; }
:bc FIELDS is fvalid=1 & fsop=5 & fsind=0 & fdly=1 & FIELDS & BODY & XT & COND & wlo { build BODY; build COND; local c:1 = COND; delayslot(8); if (c) goto XT; }
:bc FIELDS is fvalid=1 & fsop=5 & fsind=0 & fdly=2 & FIELDS & BODY & XT & COND & wlo { build BODY; build COND; local c:1 = COND; delayslot(16); if (c) goto XT; }
:bc FIELDS is fvalid=1 & fsop=5 & fsind=0 & fdly=3 & FIELDS & BODY & XT & COND & wlo { build BODY; build COND; local c:1 = COND; delayslot(24); if (c) goto XT; }
:bc FIELDS is fvalid=1 & fsop=5 & fsind=0 & fdly=4 & FIELDS & BODY & XT & COND & wlo { build BODY; build COND; local c:1 = COND; delayslot(32); if (c) goto XT; }
:loop FIELDS is fvalid=1 & fsop=3 & fsind=0 & fdly=0 & FIELDS & BODY & XT & COND & wlo { build BODY; build COND; local c:1 = COND; if (c) goto XT; }
:loop FIELDS is fvalid=1 & fsop=3 & fsind=0 & fdly=1 & FIELDS & BODY & XT & COND & wlo { build BODY; build COND; local c:1 = COND; delayslot(8); if (c) goto XT; }
:loop FIELDS is fvalid=1 & fsop=3 & fsind=0 & fdly=2 & FIELDS & BODY & XT & COND & wlo { build BODY; build COND; local c:1 = COND; delayslot(16); if (c) goto XT; }
:loop FIELDS is fvalid=1 & fsop=3 & fsind=0 & fdly=3 & FIELDS & BODY & XT & COND & wlo { build BODY; build COND; local c:1 = COND; delayslot(24); if (c) goto XT; }
:loop FIELDS is fvalid=1 & fsop=3 & fsind=0 & fdly=4 & FIELDS & BODY & XT & COND & wlo { build BODY; build COND; local c:1 = COND; delayslot(32); if (c) goto XT; }
:endcmd FIELDS is fvalid=1 & fsop=4 & fsind=1 & fsgrp=31 & fdly=0 & FIELDS & BODY & wlo { build BODY;  NEXTCMD = next_command(); return [NEXTCMD]; }
:endcmd FIELDS is fvalid=1 & fsop=4 & fsind=1 & fsgrp=31 & fdly=1 & FIELDS & BODY & wlo { build BODY;  delayslot(8); NEXTCMD = next_command(); return [NEXTCMD]; }
:endcmd FIELDS is fvalid=1 & fsop=4 & fsind=1 & fsgrp=31 & fdly=2 & FIELDS & BODY & wlo { build BODY;  delayslot(16); NEXTCMD = next_command(); return [NEXTCMD]; }
:endcmd FIELDS is fvalid=1 & fsop=4 & fsind=1 & fsgrp=31 & fdly=3 & FIELDS & BODY & wlo { build BODY;  delayslot(24); NEXTCMD = next_command(); return [NEXTCMD]; }
:endcmd FIELDS is fvalid=1 & fsop=4 & fsind=1 & fsgrp=31 & fdly=4 & FIELDS & BODY & wlo { build BODY;  delayslot(32); NEXTCMD = next_command(); return [NEXTCMD]; }
:endcmdc FIELDS is fvalid=1 & fsop=5 & fsind=1 & fsgrp=31 & fdly=0 & FIELDS & BODY & COND & wlo { build BODY; build COND; local c:1 = COND; if (!c) goto <skip>; NEXTCMD = next_command(); return [NEXTCMD]; <skip> }
:endcmdc FIELDS is fvalid=1 & fsop=5 & fsind=1 & fsgrp=31 & fdly=1 & FIELDS & BODY & COND & wlo { build BODY; build COND; local c:1 = COND; delayslot(8); if (!c) goto <skip>; NEXTCMD = next_command(); return [NEXTCMD]; <skip> }
:endcmdc FIELDS is fvalid=1 & fsop=5 & fsind=1 & fsgrp=31 & fdly=2 & FIELDS & BODY & COND & wlo { build BODY; build COND; local c:1 = COND; delayslot(16); if (!c) goto <skip>; NEXTCMD = next_command(); return [NEXTCMD]; <skip> }
:endcmdc FIELDS is fvalid=1 & fsop=5 & fsind=1 & fsgrp=31 & fdly=3 & FIELDS & BODY & COND & wlo { build BODY; build COND; local c:1 = COND; delayslot(24); if (!c) goto <skip>; NEXTCMD = next_command(); return [NEXTCMD]; <skip> }
:endcmdc FIELDS is fvalid=1 & fsop=5 & fsind=1 & fsgrp=31 & fdly=4 & FIELDS & BODY & COND & wlo { build BODY; build COND; local c:1 = COND; delayslot(32); if (!c) goto <skip>; NEXTCMD = next_command(); return [NEXTCMD]; <skip> }
:ret FIELDS is fvalid=1 & fsop=4 & fsind=1 & fdly=0 & FIELDS & BODY & wlo { build BODY;  return [LR]; }
:ret FIELDS is fvalid=1 & fsop=4 & fsind=1 & fdly=1 & FIELDS & BODY & wlo { build BODY;  delayslot(8); return [LR]; }
:ret FIELDS is fvalid=1 & fsop=4 & fsind=1 & fdly=2 & FIELDS & BODY & wlo { build BODY;  delayslot(16); return [LR]; }
:ret FIELDS is fvalid=1 & fsop=4 & fsind=1 & fdly=3 & FIELDS & BODY & wlo { build BODY;  delayslot(24); return [LR]; }
:ret FIELDS is fvalid=1 & fsop=4 & fsind=1 & fdly=4 & FIELDS & BODY & wlo { build BODY;  delayslot(32); return [LR]; }
:ret FIELDS is fvalid=1 & fsop=4 & fsind=1 & fdly=5 & FIELDS & BODY & wlo { build BODY;  delayslot(40); return [LR]; }
:ret FIELDS is fvalid=1 & fsop=4 & fsind=1 & fdly=6 & FIELDS & BODY & wlo { build BODY;  delayslot(48); return [LR]; }
:ret FIELDS is fvalid=1 & fsop=4 & fsind=1 & fdly=7 & FIELDS & BODY & wlo { build BODY;  delayslot(56); return [LR]; }
:ret FIELDS is fvalid=1 & fsop=4 & fsind=1 & fdly=8 & FIELDS & BODY & wlo { build BODY;  delayslot(64); return [LR]; }
:retc FIELDS is fvalid=1 & fsop=5 & fsind=1 & fdly=0 & FIELDS & BODY & COND & wlo { build BODY; build COND; local c:1 = COND; if (!c) goto <skip>; return [LR]; <skip> }
:retc FIELDS is fvalid=1 & fsop=5 & fsind=1 & fdly=1 & FIELDS & BODY & COND & wlo { build BODY; build COND; local c:1 = COND; delayslot(8); if (!c) goto <skip>; return [LR]; <skip> }
:retc FIELDS is fvalid=1 & fsop=5 & fsind=1 & fdly=2 & FIELDS & BODY & COND & wlo { build BODY; build COND; local c:1 = COND; delayslot(16); if (!c) goto <skip>; return [LR]; <skip> }
:retc FIELDS is fvalid=1 & fsop=5 & fsind=1 & fdly=3 & FIELDS & BODY & COND & wlo { build BODY; build COND; local c:1 = COND; delayslot(24); if (!c) goto <skip>; return [LR]; <skip> }
:retc FIELDS is fvalid=1 & fsop=5 & fsind=1 & fdly=4 & FIELDS & BODY & COND & wlo { build BODY; build COND; local c:1 = COND; delayslot(32); if (!c) goto <skip>; return [LR]; <skip> }
:retc FIELDS is fvalid=1 & fsop=5 & fsind=1 & fdly=5 & FIELDS & BODY & COND & wlo { build BODY; build COND; local c:1 = COND; delayslot(40); if (!c) goto <skip>; return [LR]; <skip> }
:retc FIELDS is fvalid=1 & fsop=5 & fsind=1 & fdly=6 & FIELDS & BODY & COND & wlo { build BODY; build COND; local c:1 = COND; delayslot(48); if (!c) goto <skip>; return [LR]; <skip> }
:retc FIELDS is fvalid=1 & fsop=5 & fsind=1 & fdly=7 & FIELDS & BODY & COND & wlo { build BODY; build COND; local c:1 = COND; delayslot(56); if (!c) goto <skip>; return [LR]; <skip> }
:retc FIELDS is fvalid=1 & fsop=5 & fsind=1 & fdly=8 & FIELDS & BODY & COND & wlo { build BODY; build COND; local c:1 = COND; delayslot(64); if (!c) goto <skip>; return [LR]; <skip> }
# Sequencer codes 0, 1, 2, 7 and code 3 with R88: UNKNOWN (rare); no flow.
:xfer FIELDS is fvalid=1 & fsop & FIELDS & BODY & wlo { build BODY; seq_unknown(fsop:1); }
