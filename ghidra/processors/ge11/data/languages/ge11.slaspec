# IMPACT GE11 geometry-engine microcode: SLEIGH specification.
# GENERATED by ghidra/processors/ge11/tools/gen_slaspec.py from the shared
# KONA generator (tools/kona_gen_slaspec.py); edit those, not this.
#
# The GE11 and the InfiniteReality (KONA) geometry engine share one 72-bit
# instruction set and one 256-bit decoded record; the labels below
# (ESTABLISHED, INFERRED, UNKNOWN) and the section names they cite (ge_isa.md,
# ge_ops.md) are the KONA repository's documents, ucode/ge_isa.md and
# ucode/ge_ops.md. GE11.h "MICROCODE INSTRUCTION WORD" summarises them.
#
# How the decode works. The chip stores a 72-bit word W. The assembler also
# shipped each word decoded to a 256-bit control record (mgras_ge.u). The
# decode from W is not known as logic, so the loader
# (ghidra_scripts/GE11Import.java) takes the record from a .u file when there
# is one, and otherwise derives it from W with data/ge11_decode.tsv, a table
# learnt from the six GE11 programs that ship both forms. It puts W[63:0] in
# code memory (one 8-byte address unit per word, so code addresses are word
# addresses) and the record groups in the context register at each word.
#
# Semantics modelled (each with its label below): the unit-1 and unit-2
# operations, the seeds, the address unit, stores, the flag word and its
# twelve-word latency, and transfers with their delay slots. Not modelled,
# because no document maps them: r128, r176, r162, r198, r217, r71, r62,
# r25, most of r95 and r110, and the latency of unit results (code that is
# software-pipelined decompiles as if each result were ready at once).
#
# GE11-only (ESTABLISHED by the 6.5.7 diagnostic, see GE11.h): the integer
# add saturates, the address unit wraps at 18 bits, special register 6 is
# CHIP_REV at 0xfffe0018.

define endian=big;
# Alignment is in bytes and must be a multiple of the 8-byte address unit.
define alignment=8;

# Code: one 8-byte unit per microcode word (W[63:0]); W[71:64] is fwtop.
define space code type=ram_space size=4 wordsize=8 default;
# The engine address space reached through address registers. Which of
# WRAM, ERAM, the special-register window (0xfffe0000) or the output window
# (0xffff0000) an address selects is UNKNOWN, so it gets its own space.
define space dmem type=ram_space size=4 wordsize=4;
# The three engine memories of the GE11 test description (INFERRED for KONA):
# WRAM (2K words, command FIFO and scratch), CRAM (512 words, shared),
# ERAM (external SRAM).
define space wram type=ram_space size=2 wordsize=4;
define space cram type=ram_space size=2 wordsize=4;
define space eram type=ram_space size=4 wordsize=4;
define space register type=register_space size=4;

# Arithmetic registers (r148 operands, P and Q destinations).
define register offset=0x0 size=4 [ R0 R1 R2 R3 R4 R5 R6 R7 R8 R9 R10 R11 R12 R13 R14 R15 R16 R17 R18 R19 R20 R21 R22 R23 R24 R25 R26 R27 R28 R29 R30 R31 ];
# Address registers (A, B, C, G); 18 bits wide, ESTABLISHED for the GE11 by
# the aalu3 test. Held here sign-extended from bit 17 (see AUS).
define register offset=0x100 size=4 [ AR0 AR1 AR2 AR3 AR4 AR5 AR6 AR7 AR8 AR9 AR10 AR11 AR12 AR13 AR14 AR15 AR16 AR17 AR18 AR19 AR20 AR21 AR22 AR23 AR24 AR25 AR26 AR27 AR28 AR29 AR30 AR31 ];
# SEED: the seed result unit 2 reads through selector 0, the seed of the
# operand two words back (ESTABLISHED, ge_isa.md "Unit-2 and seed-unit
# operands"); SEED0 and SEED1 hold this word's and the last word's seeds.
# LR: return address the hardware keeps (INFERRED stack, modelled as one register).
# NEXTCMD: the next handler the dispatch hardware supplies (INFERRED).
define register offset=0x200 size=4 [ SEED LR NEXTCMD PC SP SEED0 SEED1 SDOP ];
# Per-word scratch: operands, unit results, address-unit result, store data.
define register offset=0x300 size=4 [ OPAV OPBV U1V U2V AUV CSRC STV LDV LDL P1V P2V ];
# U1H0..U1H7, U2H0..U2H7: each unit's result 0..7 words ago, the window
# result forwarding reads (ESTABLISHED, ge_isa.md "Operand ports").
define register offset=0x380 size=4 [ U1H0 U1H1 U1H2 U1H3 U1H4 U1H5 U1H6 U1H7 U2H0 U2H1 U2H2 U2H3 U2H4 U2H5 U2H6 U2H7 ];
# FL: the condition word FPU_COND_A, low nibble unit 1, high nibble unit 2,
# each bit 3 <= 0, bit 2 zero, bit 1 negative, bit 0 second operand passed.
# FLD1..FLD12: FL as it was 1..12 words ago (the twelve-word flag latency).
# AZ/AGT: address-unit zero and greater-than; AZD*/AGTD*: one and two
# words ago (address-unit conditions arrive after two words, ESTABLISHED).
define register offset=0x400 size=1 [ FL FLD1 FLD2 FLD3 FLD4 FLD5 FLD6 FLD7 FLD8 FLD9 FLD10 FLD11 FLD12 AZ AGT AZD1 AGTD1 AZD2 AGTD2 ];
define register offset=0x1000 size=36 [ contextreg ];
define context contextreg
  fimm=(0,31)  noflow
  fsimm=(0,31) signed noflow
  fw71=(32,32)  noflow
  f222=(33,33)  noflow
  f221=(34,34)  noflow
  f220=(35,35)  noflow
  f219=(36,37)  noflow
  f217=(38,39)  noflow
  f215=(40,41)  noflow
  f213=(42,43)  noflow
  f211=(44,45)  noflow
  fcc=(46,56)  noflow
  f198=(57,63)  noflow
  fA=(64,68)  noflow
  fAr=(64,68)  noflow
  fB=(69,73)  noflow
  fBr=(69,73)  noflow
  fC=(74,78)  noflow
  fCr=(74,78)  noflow
  f176=(79,80)  noflow
  fD=(81,86)  noflow
  fE=(87,92)  noflow
  f162=(93,95)  noflow
  fF=(96,101)  noflow
  fG=(102,106)  noflow
  fGr=(102,106)  noflow
  f148h=(107,111)  noflow
  f148hr=(107,111)  noflow
  f148l=(112,116)  noflow
  f148lr=(112,116)  noflow
  fP=(117,121)  noflow
  fPr=(117,121)  noflow
  fQ=(122,126)  noflow
  fQr=(122,126)  noflow
  fvalid=(127,127)  noflow
  f128=(128,134)  noflow
  f128p1=(129,131)  noflow
  f128p2=(132,134)  noflow
  fMk=(135,138)  noflow
  fMu=(139,145)  noflow
  f110=(146,156)  noflow
  f110b10=(146,146)  noflow
  f110s1=(147,148)  noflow
  f110s2=(149,150)  noflow
  f110u1=(151,152)  noflow
  f110u2=(153,154)  noflow
  f110sd=(155,155)  noflow
  f99h=(160,160)  noflow
  f99l=(161,163)  noflow
  f99b2=(161,161)  noflow
  f95=(164,170)  noflow
  fsind=(171,171)  noflow
  fsrel=(172,172)  noflow
  fsop=(173,175) dec noflow
  fsmid=(176,182)  noflow
  fsgrp=(183,187) dec noflow
  f71=(192,200)  noflow
  f62h=(201,205)  noflow
  fwtop=(206,213)  noflow
  fdly=(214,217)  noflow
  fform=(218,221)  noflow
  f62l=(224,255)  noflow
  f25=(256,281)  noflow
;
define token word(64) wlo=(0,63);

attach variables [ f148hr f148lr fPr fQr ] [ R0 R1 R2 R3 R4 R5 R6 R7 R8 R9 R10 R11 R12 R13 R14 R15 R16 R17 R18 R19 R20 R21 R22 R23 R24 R25 R26 R27 R28 R29 R30 R31 ];
attach variables [ fAr fBr fCr fGr ] [ AR0 AR1 AR2 AR3 AR4 AR5 AR6 AR7 AR8 AR9 AR10 AR11 AR12 AR13 AR14 AR15 AR16 AR17 AR18 AR19 AR20 AR21 AR22 AR23 AR24 AR25 AR26 AR27 AR28 AR29 AR30 AR31 ];

