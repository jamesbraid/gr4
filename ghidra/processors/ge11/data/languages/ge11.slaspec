G_seq: is fsgrp=0x4 & fsmid=0x7f & fsop=0x6 & fsrel=0x0 & fsind=0x0 { }
G_seq: "seq="^v is fsgrp & fsmid & fsop & fsrel & fsind [ v = fsgrp | (fsmid << 5) | (fsop << 12) | (fsrel << 15) | (fsind << 16); ] { }
G_r71: is f71=0x0 { }
G_r71: "r71="^f71 is f71 { }
G_r62: is f62h=0x1f & f62l=0xfc000170 { }
G_r62: "r62="^f62h^":"^f62l is f62h & f62l { }
