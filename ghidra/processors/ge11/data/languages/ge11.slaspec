XREL: is fsrel=0 { }
XREL: ".rel" is fsrel=1 { }
# Transfer target: the immediate, or the word's own address plus the signed
# immediate when R87 (fsrel) is set (INFERRED, ge_isa.md "Transfers").
XT: dst is fsrel=0 & fimm [ dst = fimm & 0xffff; ] { export *[code]:8 dst; }
XT: dst is fsrel=1 & fsimm [ dst = (inst_start + fsimm) & 0xffff; ] { export *[code]:8 dst; }
XF: is fsop=6 { }
# The target shown is a number: an address operand in the display would
# make Ghidra add a data reference for the transfers it cannot follow.
XTD: dst is fsrel=0 & fimm [ dst = fimm & 0xffff; ] { }
XTD: dst is fsrel=1 & fsimm [ dst = (inst_start + fsimm) & 0xffff; ] { }
XF: "xfer"^fsop^XREL " c"^fsgrp " cc="^fcc " -> "^XTD is fsop & XREL & fsgrp & fcc & XTD { }
FIELDS: XF G_imm G_w71 G_r222 G_r221 G_r220 G_r219 G_r217 G_r215 G_r213 G_r211 G_cc G_r198 G_A G_B G_C G_r176 G_D G_E G_r162 G_F G_G G_r148 G_P G_Q G_r128 G_M G_r110 G_r99 G_r95 G_seq G_r71 G_r62 G_r25 is XF & G_imm & G_w71 & G_r222 & G_r221 & G_r220 & G_r219 & G_r217 & G_r215 & G_r213 & G_r211 & G_cc & G_r198 & G_A & G_B & G_C & G_r176 & G_D & G_E & G_r162 & G_F & G_G & G_r148 & G_P & G_Q & G_r128 & G_M & G_r110 & G_r99 & G_r95 & G_seq & G_r71 & G_r62 & G_r25 { }

