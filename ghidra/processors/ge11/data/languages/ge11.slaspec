U1N: "dadd" is fMu=0x20 { }
U1N: "dsub" is fMu=0x22 { }
U1N: "iadd" is fMu=0x40 { }
U1N: "isub" is fMu=0x42 { }
U1N: "mov" is fMu=0x4a { }
