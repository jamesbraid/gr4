define pcodeop rcp_seed;
define pcodeop rsqrt_seed;
define pcodeop seed_op;
define pcodeop aalu;
define pcodeop cond_test;
define pcodeop abort_requested;
define pcodeop store_predicate;
define pcodeop next_command;
define pcodeop seq_unknown;
define pcodeop passb;
define pcodeop read_r95_14;

# ---- Display: one subtable per record group, empty at its no-op value.
G_imm: is fimm=0x0 { }
